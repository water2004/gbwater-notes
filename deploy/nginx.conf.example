# 页面路径与 GBWATER_BASE_PATH 一致，API location 与 GBWATER_API_BASE_PATH 一致。
# API 前缀留空时取站点路径加 api/。反代目标末尾保留 /api/。
server {
    listen 443 ssl;
    server_name notes.example.com;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/notes.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/notes.example.com/privkey.pem;

    location = /mypdf {
        return 308 /mypdf/;
    }

    location ^~ /mypdf/api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        client_max_body_size 12m;
    }

    location /mypdf/assets/ {
        alias /var/www/gbwater/frontend/assets/;
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri =404;
    }

    location /mypdf/admin-assets/ {
        alias /var/www/gbwater/frontend/admin-assets/;
        add_header Cache-Control "no-store" always;
        etag off;
        if_modified_since off;
        try_files $uri =404;
    }

    location /mypdf/generated/ {
        alias /var/www/gbwater/frontend/generated/;
        add_header Cache-Control "public, max-age=2592000, immutable";
        try_files $uri =404;
    }

    location /mypdf/content-assets/ {
        alias /var/www/gbwater/frontend/content-assets/;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # 构建临时目录和增量索引位于同一挂载内。
    location ~ ^/mypdf/\. {
        return 404;
    }

    # 直接打开带笔记 ID 的编辑器地址时，交给 Vue Router 解析。
    location ~ ^/mypdf/admin/editor/(?!index\.html$).+ {
        rewrite ^ /mypdf/admin/editor/ last;
    }

    location /mypdf/ {
        alias /var/www/gbwater/frontend/;
        try_files $uri $uri/ =404;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "no-cache" always;
    }
}
