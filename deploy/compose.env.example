GBWATER_IMAGE=ghcr.io/water2004/gbwater-notes:1.0.0
GBWATER_SITE_URL=https://notes.example.com
GBWATER_BASE_PATH=/mypdf/
GBWATER_PORT=8080

# 用 openssl rand -hex 24 分别生成数据库密码和搜索密钥。
GBWATER_DB_PASSWORD=
GBWATER_MEILISEARCH_KEY=

GBWATER_ADMIN_USER=admin
GBWATER_ADMIN_EMAIL=admin@example.com
GBWATER_ADMIN_PASSWORD=
GBWATER_ALLOW_REGISTRATION=false

GBWATER_MAIL_MODE=off
# GBWATER_SMTP_ADDR=smtp.example.com:587
# GBWATER_SMTP_USER=no-reply@example.com
# GBWATER_SMTP_PASSWORD=
# GBWATER_SMTP_FROM=no-reply@example.com
# GBWATER_SMTP_TLS=starttls

# 网段冲突时一起调整；信任地址是宿主机访问容器所经过的 Docker 网关。
# GBWATER_DOCKER_SUBNET=172.30.92.0/24
# GBWATER_DOCKER_GATEWAY=172.30.92.1
