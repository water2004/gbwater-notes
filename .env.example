# 运行根目录与监听地址
# GBWATER_ROOT=.
GBWATER_ADDR=127.0.0.1:8080
GBWATER_ENV=development

# 站点地址与挂载路径。BasePath 决定静态资源前缀，可部署在任意子目录；
# 变更后在后台重新构建，Go 和 Vite 共用此值。
GBWATER_SITE_URL=http://127.0.0.1:5173
GBWATER_BASE_PATH=/mypdf/
GBWATER_API_BASE_PATH=

# Go 服务运行构建任务时需要 Folia 和 Node。
GBWATER_BUILD_ENABLED=true

# 首个管理员：仅在数据库里还没有可用管理员时创建，之后以数据库为准
GBWATER_ADMIN_USER=admin
GBWATER_ADMIN_EMAIL=admin@example.com
GBWATER_ADMIN_PASSWORD=replace-with-a-long-random-password

# PostgreSQL
GBWATER_DATABASE_URL=postgres://gbwater:replace-with-a-database-password@127.0.0.1:5432/gbwater?sslmode=disable

# Meilisearch
GBWATER_MEILISEARCH_URL=http://127.0.0.1:7700
GBWATER_MEILISEARCH_KEY=replace-with-the-meilisearch-master-key

# 账号体系
GBWATER_ALLOW_REGISTRATION=true
GBWATER_SESSION_TTL_HOURS=720
# nginx 与 Go 不在同一台机器时，填写 nginx 发起代理连接的 IP（可用逗号分隔）。
# GBWATER_TRUSTED_PROXIES=192.0.2.10

# smtp 投递验证码。log 仅供本地开发。off 关闭验证码邮件。
GBWATER_MAIL_MODE=log
# GBWATER_SMTP_ADDR=smtp.example.com:587
# GBWATER_SMTP_USER=no-reply@example.com
# GBWATER_SMTP_PASSWORD=
# 可用“显示名 <address>”，省略时使用邮箱格式的 GBWATER_SMTP_USER。
# GBWATER_SMTP_FROM=no-reply@example.com
# starttls（587）| tls（465，隐式 TLS）| none（无凭据的本机中继）
# GBWATER_SMTP_TLS=starttls

# Folia 原生渲染
# GBWATER_FOLIA_BRIDGE=data/folia-bridge-build/folia_md
# GBWATER_FOLIA_LIB_DIR=data/folia-bridge-build/lib
